#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf
/dev.sh         text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Historical evidence and exported packages must retain their original bytes.
/development-assets/** -text -whitespace
/art/production-v2/** -text -whitespace
/art/production-docs/*.csv -text -whitespace
